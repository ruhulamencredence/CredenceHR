# MySQL Database Configuration (XAMPP / Local)
DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="mpr_tracker_db"
DB_PORT="3306"

# JWT Secret for Authentication
JWT_SECRET="super_secret_jwt_key_mpr_tracker_2026"
PORT="3000"

# Superadmin Account — the ONLY way a superadmin account is created/updated.
# Server startup reads these and creates (or syncs) this account automatically as
# role='superadmin'. From the Admin Panel -> Users tab, the Superadmin then
# creates/promotes other Admins and Users, and picks which Admin Panel modules
# (Projects, MPR Numbers, Data Import, Reports, Users, Job Recycle, MPR Edit Log)
# each Admin can access. Change these before first run, and change
# ADMIN_PASSWORD again after go-live.
ADMIN_NAME="System Admin"
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_PASSWORD="ChangeThisPassword123"

# CARTO Voyager map tiles (attendance/claim check-in-out maps, employee
# tracking panel). Free within CARTO's fair-use limit (5M tile requests a
# month). VITE_ prefix means Vite bundles this into the frontend build --
# get a free key at https://carto.com/basemaps/apikey
VITE_CARTO_API_KEY=""

# SMTP Configuration — required for Payroll -> Payslips -> "Email Payslip(s)"
# (POST /api/payroll/:id/email and /api/payroll/email-bulk in PayrollRoutes.ts).
# Leave these unset to keep Email Payslips disabled (the buttons will show a
# clear "email isn't set up yet" message instead of failing silently).
# Any standard SMTP provider works (Gmail App Password, SendGrid, Mailgun, etc).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Firebase Cloud Messaging — required for Chat push notifications
# (ChatRoutes.ts's notifyNewMessage / src/lib/pushNotifications.ts). Leave
# unset to keep push notifications disabled (Chat itself still works
# normally over Socket.IO/REST whenever the app is open). To enable: create a
# Firebase project, add an Android app to it with this app's applicationId
# (see android/app/build.gradle), download google-services.json into
# android/app/, then Project Settings -> Service Accounts -> Generate new
# private key -- paste that whole JSON file's contents here as one line.
FIREBASE_SERVICE_ACCOUNT_JSON=""

