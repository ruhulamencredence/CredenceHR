# MySQL Database Configuration (XAMPP / Local)
DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="mpr_tracker_db"
DB_PORT="3306"

# JWT Secret for Authentication — anyone who knows it can sign in as any
# account. On a live server replace it with a long random value:
#   openssl rand -hex 48
# (changing it signs everyone out once). Left empty, or shorter than 32
# characters, the server makes a random key itself and keeps it in
# .jwt-secret; several servers behind one address need the same value here.
JWT_SECRET=""
PORT="3000"

# Other websites that may call this server's API from a browser, comma
# separated (the website and the app themselves load from this server and
# are always allowed). Empty = any website may (not recommended).
CORS_ORIGINS=""

# Superadmin Account — the ONLY way a superadmin account is created/updated.
# Server startup reads these and creates (or syncs) this account automatically as
# role='superadmin'. From the Admin Panel -> Users tab, the Superadmin then
# creates/promotes other Admins and Users, and picks which Admin Panel modules
# (Projects, MPR Numbers, Data Import, Reports, Users, Job Recycle, MPR Edit Log)
# each Admin can access. Change these before first run, and change
# ADMIN_PASSWORD again after go-live.
ADMIN_NAME="System Admin"
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_PASSWORD="ChangeThisPassword123"

# CARTO Voyager map tiles (attendance/claim check-in-out maps, employee
# tracking panel). Free within CARTO's fair-use limit (5M tile requests a
# month). VITE_ prefix means Vite bundles this into the frontend build --
# get a free key at https://carto.com/basemaps/apikey
VITE_CARTO_API_KEY=""

# SMTP Configuration — required for Payroll -> Payslips -> "Email Payslip(s)"
# Also sends the "Forgot password?" codes from the login page (Users ->
# Password requests -> Code by email).
# (POST /api/payroll/:id/email and /api/payroll/email-bulk in PayrollRoutes.ts).
# Leave these unset to keep Email Payslips disabled (the buttons will show a
# clear "email isn't set up yet" message instead of failing silently).
# Any standard SMTP provider works (Gmail App Password, SendGrid, Mailgun, etc).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Credence Mail (Self Service -> Credence Mail, MailRoutes.ts) — each person's
# own mailbox inside CredenceHR. Their mailbox passwords are kept encrypted
# (AES-256-GCM) with this key; there is no built-in key, so until it is set
# nobody can connect a mailbox. Make one with:
#   openssl rand -hex 32
# Keep it secret and NEVER change or lose it once people have connected
# mailboxes — with a different key every saved password becomes unreadable
# and everyone has to connect their mailbox again. Use the same key on every
# server process (PM2 cluster workers read the same .env).
MAIL_ENCRYPTION_KEY=""
# Optional limits (defaults shown):
# Mailboxes syncing at the same time over the whole server.
# MAIL_MAX_IMAP="20"
# Live connections that bring new mail at once, for people who are online
# (more than this get checked every 3 minutes instead).
# MAIL_MAX_IDLE="200"
# How many of the latest mails per folder the first sync copies.
# MAIL_INITIAL_SYNC="200"

# Firebase Cloud Messaging — required for Chat push notifications
# (ChatRoutes.ts's notifyNewMessage / src/lib/pushNotifications.ts). Leave
# unset to keep push notifications disabled (Chat itself still works
# normally over Socket.IO/REST whenever the app is open). To enable: create a
# Firebase project, add an Android app to it with this app's applicationId
# (see android/app/build.gradle), download google-services.json into
# android/app/, then Project Settings -> Service Accounts -> Generate new
# private key -- paste that whole JSON file's contents here as one line.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Socket.IO Redis adapter — required once running more than one server
# process (PM2 cluster mode / multiple instances behind Nginx, see
# ecosystem.config.cjs and deploy/nginx.conf.example). Without it, Socket.IO
# only broadcasts chat messages/rooms/presence to sockets connected to the
# SAME process, so a user on one worker never hears from a user on another.
# Leave unset for a single-process deployment (today's default) — nothing
# else changes. Point it at a real Redis instance before enabling more than
# one PM2 instance in production, e.g. redis://127.0.0.1:6379
REDIS_URL=""


# Chat audio/video calls (CallRoutes.ts) — TURN relay, optional. Calls work
# with Google's public STUN alone; a TURN relay lets the ones behind strict
# mobile / office networks connect too. Set ONE of the two:
#   Cloudflare Calls TURN (Dashboard -> Calls -> TURN keys):
CLOUDFLARE_TURN_KEY_ID=""
CLOUDFLARE_TURN_API_TOKEN=""
#   …or any TURN server (e.g. your own coturn), comma-separated URLs:
#   TURN_URLS="turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349"
TURN_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# AI Assistant (AiAssistantRoutes.ts). Without a key the Assistant still works
# with its built-in Bangla/English answers. With a Google Gemini key it can
# also answer free-form questions, write down spoken questions and read
# answers aloud (the question and the account's own figures are then sent to
# Google). Get a key at https://aistudio.google.com/apikey
#
# One key:
GEMINI_API_KEY=""
#
# Several keys — make each one in its OWN Google Cloud project ("Create API
# key in new project"); keys of one project share that project's quota. One
# key is used at a time; when its quota is used up it rests (15 min, doubling
# up to 6 h) and the next key answers the same question at once. Only when
# every key is used up does the built-in engine answer alone. One line,
# comma-separated, the first key is used first. GEMINI_API_KEY above, if
# set, is added to this list. Example (made-up keys — put your own):
#   GEMINI_API_KEYS="AIzaSyA1111111111111111111111111111111,AIzaSyB2222222222222222222222222222222,AIzaSyC3333333333333333333333333333333"
GEMINI_API_KEYS=""
#
# Optional — models to try in order (comma-separated); the next is used when
# one is busy, gone or rate-limited:
# GEMINI_MODEL="gemini-flash-lite-latest,gemini-flash-latest,gemini-3.8-flash"
# Writing down spoken questions (🎤):
# GEMINI_TRANSCRIBE_MODEL="gemini-flash-lite-latest,gemini-flash-latest"
# Reading answers aloud (🔊) — the voice models are found by themselves; set
# this only to force one. The default voice when a person hasn't picked one
# in the Assistant (Kore, Aoede, Leda, Despina, Sulafat, Achird, Puck…):
# GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"
# GEMINI_TTS_VOICE="Kore"

# E-Signature (Document Vault -> Signatures, ESignRoutes.ts) — the public
# address of this app, printed on every signed PDF as its verification link
# and QR code (<address>/verify/<code>). Set it to the address people open,
# e.g. https://hr.credencehousinglimited.com — without it the address the
# last signer used is printed instead.
PUBLIC_APP_URL=""
# The server's seal on every signed PDF (HMAC-SHA256 of the PDF's fingerprint
# and its history), checked by /verify. Make one with: openssl rand -hex 32
# Keep it secret and never change it — documents sealed with an old key read
# "seal doesn't match". Without it signed PDFs are simply not sealed. It also
# salts the stored signing codes (OTP).
ESIGN_SEAL_KEY=""
# Digital signature with a certificate (Document Vault -> E-Signature settings
# -> "Digital signature (certificate)"): the finished signed PDF is also signed
# inside the file, so Adobe Reader shows it as signed. Put the company's
# certificate from a licensed Certifying Authority (in Bangladesh one licensed
# by the CCA) here as a .p12 / .pfx file with its password. Without it the
# server makes a self-signed certificate in the company's name: it still
# catches any change, but Adobe shows "validity unknown".
ESIGN_CERT_FILE=""
ESIGN_CERT_PASSWORD=""

# Chat attachments (voice, image, video, document) are saved as files in this
# folder; the database keeps only each file's path. Default: uploads/chat in
# the app folder. Inside it: voice/, image/, video/, document/ (by year and
# month). Use a full path outside the app folder on the server, e.g.
# /var/lib/credencehr/chat — and back it up together with the database.
# The server account must be able to write to it; it is never served as a
# public folder (files go out only to members of that chat).
CHAT_ATTACHMENT_DIR=""
# Optional — put one kind somewhere else (leave empty to use the folder above):
CHAT_VOICE_DIR=""
CHAT_IMAGE_DIR=""
CHAT_VIDEO_DIR=""
CHAT_DOCUMENT_DIR=""

# Notice pictures and attachments (Admin Panel -> Notices) are saved as files
# in this folder; the database keeps only each file's path. Default:
# uploads/notices in the app folder (image/ and file/ inside, by year and
# month). Use forward slashes, e.g. "D:/CredenceHR/notices". Back it up with
# the database. Never served as a public folder.
NOTICE_FILES_DIR=""

# Payroll -> Approval: the scans / photos of the signed salary sheet (HR
# Director's and MD's copies) are saved in this folder; the database keeps
# only each file's path. Default: uploads/payroll in the app folder (by year
# and month). Use forward slashes, e.g. "D:/CredenceHR/payroll". Back it up
# with the database. Never served as a public folder.
PAYROLL_FILES_DIR=""
