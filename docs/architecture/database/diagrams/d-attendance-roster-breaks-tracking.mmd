erDiagram
  attendance {
    int id PK
    int user_id FK
    int project_id FK
    date attendance_date
    timestamp check_in_at
    decimal check_in_lat
    decimal check_in_lng
  }
  attendance_corrections {
    int id PK
    int user_id FK
    int project_id FK
    date attendance_date
    datetime requested_check_in_at
    datetime requested_check_out_at
    text remarks
  }
  attendance_report_department_access {
    int id PK
    int user_id FK
    varchar department
  }
  break_settings {
    int id PK
    int company_id
    int allowed_minutes
    int max_breaks
  }
  duty_roster {
    int id PK
    int employee_id FK
    int shift_id FK
    date roster_date
    tinyint is_off
    varchar note
  }
  duty_roster_department_access {
    int id PK
    int user_id FK
    varchar department
  }
  duty_shifts {
    int id PK
    int company_id
    varchar name
    varchar code
    time start_time
    time end_time
    int grace_minutes
  }
  employee_breaks {
    int id PK
    int user_id FK
    date break_date
    datetime started_at
    datetime ended_at
    int minutes
    varchar note
  }
  late_policy_settings {
    int id PK
    time shift_start_time
    int grace_minutes
    int lates_per_deduction_day
    int extreme_grace_minutes
    int extreme_lates_per_deduction_day
    date effective_date
  }
  late_waivers {
    int id PK
    int employee_id FK
    int waived_by FK
    date waiver_date
    varchar reason
  }
  location_pings {
    int id PK
    int user_id FK
    decimal lat
    decimal lng
    int accuracy_m
    int battery_pct
    timestamp recorded_at
  }
  site_attendance_entries {
    int id PK
    int sheet_id FK
    int employee_id FK
    int team_id
    date attendance_date
    varchar status
    varchar in_time
  }
  site_attendance_members {
    int id PK
    int team_id FK
    int employee_id FK
  }
  site_attendance_settings {
    int id PK
    tinyint require_approval
    tinyint require_photo
    tinyint require_location
    int backdate_days
    varchar reminder_time
    int company_id
  }
  site_attendance_sheets {
    int id PK
    int team_id FK
    date attendance_date
    varchar status
    timestamp submitted_at
    decimal lat
    decimal lng
  }
  site_attendance_teams {
    int id PK
    int project_id FK
    varchar name
    varchar site_location
    int supervisor_user_id
    int backup_user_id
    decimal lat
  }
  tracking_department_access {
    int id PK
    int user_id FK
    varchar department
  }
  tracking_device_state {
    int user_id PK,FK
    tinyint location_on
    tinyint foreground_granted
    tinyint background_granted
    tinyint precise_granted
    varchar mode
    int battery_pct
  }
  tracking_employee_access {
    int id PK
    int user_id FK
    int employee_pk
  }
  tracking_notice_recipients {
    int id PK
    int notice_id FK
    int user_id FK
    int employee_pk
    varchar reason
    datetime last_ping
    timestamp sent_at
  }
  vehicle_ride_settings {
    int id PK
    int grace_minutes
    int reminder_minutes
  }
  zk_attendance_logs {
    int id PK
    int device_id FK
    varchar device_user_pin
    datetime punch_time
    int verify_mode
    int work_code
    timestamp synced_at
  }
  zk_devices {
    int id PK
    varchar name
    varchar ip_address
    int port
    varchar serial_number
    tinyint is_active
    timestamp last_synced_at
  }
  all_employees {
    int id PK
  }
  notices {
    int id PK
  }
  projects {
    int id PK
  }
  users {
    int id PK
  }
  projects ||--o{ attendance : "project_id"
  users ||--o{ attendance : "user_id"
  projects ||--o{ attendance_corrections : "project_id"
  users ||--o{ attendance_corrections : "user_id"
  users ||--o{ attendance_report_department_access : "user_id"
  all_employees ||..o{ duty_roster : "employee_id"
  duty_shifts ||..o{ duty_roster : "shift_id"
