erDiagram
  hr_emp_education {
    int id PK
    int employee_id FK
    varchar level
    varchar degree
    varchar major
    varchar institute
    varchar board_university
  }
  branches {
    int id PK
    int project_id FK
    varchar branch_name
    decimal location_lat
    decimal location_lng
    varchar location_label
    int location_radius
  }
  employee_transfers {
    int id PK
    int employee_id FK
    int from_supervisor_id FK
    int to_supervisor_id FK
    int action_by FK
    int from_department_id
    varchar from_department_name
  }
  departments {
    int id PK
    int supervisor_user_id FK
    varchar name
    tinyint include_supervisor_approval
    tinyint is_active
    int company_id
  }
  employee_pay_items {
    int id PK
    int employee_id FK
    int component_id
    varchar name
    enum kind
    decimal amount
    varchar start_month
  }
  hr_emp_experience {
    int id PK
    int employee_id FK
    varchar company_name
    varchar company_business
    varchar location
    varchar designation
    varchar department
  }
  hr_emp_family {
    int id PK
    int employee_id FK
    varchar name
    varchar relation
    date date_of_birth
    varchar occupation
    varchar phone
  }
  employee_change_log {
    int id PK
    int employee_id FK
    int action_by FK
    varchar field_name
    text old_value
    text new_value
  }
  hr_employee_service {
    int id PK
    int employee_id FK
    varchar grade
    int probation_months
    date probation_end_date
    date confirmation_date
    date contract_end_date
  }
  projects {
    int id PK
    varchar project_name
    decimal location_lat
    decimal location_lng
    varchar location_label
    int company_id
    int location_radius
  }
  employee_payment_accounts {
    int id PK
    int employee_id FK
    enum account_type
    varchar account_label
    varchar bank_name
    varchar branch_name
    varchar provider
  }
  employee_company_assignments {
    int id PK
    int employee_id FK
    int company_id
    varchar employee_code
    varchar designation
    varchar department
    date start_date
  }
  hr_emp_training {
    int id PK
    int employee_id FK
    varchar title
    varchar training_type
    varchar organizer
    varchar location
    date from_date
  }
  all_employees {
    int id PK
    int user_id FK
    int department_id FK
    int branch_id FK
    varchar employee_id
    varchar zk_device_pin
    varchar name
  }
  holiday_calendar {
    int id PK
    date entry_date
    enum day_type
    varchar title
    enum applies_to
    int company_id
  }
  company_groups {
    int id PK
    varchar name
    varchar short_name
    varchar logo_mime
    longblob logo_data
    varchar workspace_code
    varchar tagline
  }
  employee_supervisors {
    int id PK
    int employee_id FK
    int supervisor_id FK
    date effective_date
    tinyint is_direct
  }
  server_profiles {
    int id PK
    varchar name
    varchar url
    int group_id
  }
  companies {
    int id PK
    int group_id FK
    varchar name
    varchar short_code
    tinyint is_mother
    varchar address
    varchar phone
  }
  employee_advances {
    int id PK
    int employee_id FK
    decimal total_amount
    decimal monthly_installment
    decimal paid_amount
    varchar reason
    enum status
  }
  employee_documents {
    int id PK
    int user_id FK
    varchar doc_type
    varchar file_name
    varchar file_mimetype
    longblob file_data
    tinyint requires_signature
  }
  users {
    int id PK
  }
