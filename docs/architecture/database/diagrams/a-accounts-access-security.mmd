erDiagram
  access_templates {
    int id PK
    varchar name
    varchar description
    text features_json
    text modules_json
    tinyint is_default
    int features_rev
  }
  admin_module_permission_layers {
    int id PK
    int user_id FK
    varchar module_key
    varchar layer_key
  }
