    int id PK
    int user_id FK
    varchar module_key
    int company_id
  }
  employee_template_assignments {
    int id PK
    int employee_user_id FK
    int template_id FK
    enum request_type
  }
  fingerprint_logins {
    int id PK
    int user_id FK
    varchar kind
    varchar device_id
    varchar label
    varchar credential_id
    text public_key
  }
  login_attempts {
    int id PK
    int user_id FK
    varchar ip
    varchar identifier
    tinyint success
  }
  password_reset_codes {
    int id PK
    int user_id FK
    datetime expires_at
    int attempts
    datetime used_at
  }
  password_reset_log {
    int id PK
    int user_id FK
    varchar ip
    varchar kind
  }
