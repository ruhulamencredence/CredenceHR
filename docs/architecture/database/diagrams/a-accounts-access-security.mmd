    int company_id
    timestamp visited_at
  }
  session_policy {
    int id PK
    int web_hours
    int web_idle_minutes
    int app_days
    int app_idle_days
  }
  user_access_audit {
    int id PK
    int target_user_id
    int actor_user_id
    varchar action
    text detail
  }
  user_company_access {
    int id PK
    int user_id FK
    int company_id
    tinyint is_default
  }
  user_devices {
    int id PK
    int user_id FK
    varchar device_id
    varchar device_name
    varchar platform
