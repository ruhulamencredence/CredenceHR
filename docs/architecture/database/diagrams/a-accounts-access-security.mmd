    int user_id PK,FK
    varchar first_name
    varchar last_name
    date date_of_birth
    varchar country
    varchar state
    varchar city
  }
  user_project_permissions {
    int id PK
    int user_id FK
    int project_id FK
  }
  user_sessions {
    int id PK
    int user_id FK
    char session_key
    varchar client
    int device_row_id
    varchar ip
    varchar user_agent
  }
  user_signatures {
    int user_id PK,FK
    mediumblob image
  }
  users {
    int id PK
    int attendance_project_id FK
    varchar name
    varchar email
    varchar username
    enum role
    decimal last_login_lat
  }
  web_push_keys {
    int id PK
    varchar public_key
    varchar private_key
  }
  web_push_subscriptions {
    int id PK
    int user_id FK
    varchar endpoint
    varchar p256dh
    varchar auth
    varchar user_agent
    timestamp last_used_at
  }
