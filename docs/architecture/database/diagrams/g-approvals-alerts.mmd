erDiagram
  alerts {
    int id PK
    int user_id FK
    varchar type
    varchar title
    text message
    varchar related_type
    int related_id
  }
  approval_chain_steps {
    int id PK
    int user_id FK
    int step_order
  }
  approval_requests {
    int id PK
    int template_id FK
    int supervisor_step_user_id FK
    enum source_type
    enum event_type
    int source_id
    enum status
  }
  approval_template_step_approvers {
    int id PK
    int step_id FK
    int user_id FK
  }
  approval_template_steps {
    int id PK
    int template_id FK
    int step_order
    enum approver_type
    varchar label
  }
  approval_templates {
    int id PK
    varchar name
    enum request_type
    tinyint is_default
    tinyint is_active
    int company_id
    tinyint skip_auto_supervisor
  }
  users {
    int id PK
  }
  users ||--o{ alerts : "user_id"
  users ||--o{ approval_chain_steps : "user_id"
  users ||--o{ approval_requests : "supervisor_step_user_id"
  approval_templates ||--o{ approval_requests : "template_id"
  approval_template_steps ||--o{ approval_template_step_approvers : "step_id"
  users ||--o{ approval_template_step_approvers : "user_id"
  approval_templates ||--o{ approval_template_steps : "template_id"