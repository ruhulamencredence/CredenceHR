<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- allowBackup=false: with it true (Android's default), the WebView's
         localStorage — including the login JWT (see App.tsx's mpr_token) —
         got swept into Android Auto Backup and silently restored on a fresh
         install signed into the same Google account, so uninstalling the
         app never actually logged anyone out (and, worse, could carry a
         session onto a different device backed up to the same account).
         false means an uninstall now genuinely clears everything. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Sign-in from 360 ERP (SsoConsume.tsx): a phone browser's "Open in
                 the CredenceHR app" opens credencehr://sso/consume/<token> here;
                 main.tsx takes it (@capacitor/app appUrlOpen / getLaunchUrl). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="credencehr" android:host="sso" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Live Follow (LiveWakeMessagingService.java / LiveTrackingService.java):
             our Firebase service replaces the push plugin's own (it passes every
             message on to it), so a silent "go live" push starts native live
             reporting even with the app in Recent apps or swiped away. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".LiveWakeMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name=".LiveTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <!-- Everyday Employee Tracking, reported natively so it keeps going
             in the background / after the app is swiped away. -->
        <service
            android:name=".DutyTrackingService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="location" />
        <!-- A chat call in progress keeps going when the app is left (CallService.java):
             "Ongoing call" notification, with Hang up. -->
        <service
            android:name=".CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />
        <receiver
            android:name=".CallService$HangupReceiver"
            android:exported="false" />
        <!-- Incoming chat call: Decline from the notification (IncomingCall.java). -->
        <receiver
            android:name=".IncomingCall$DeclineReceiver"
            android:exported="false" />
        <!-- Employee Tracking's repeating wake-up (works in Doze). -->
        <receiver
            android:name=".DutyAlarmReceiver"
            android:exported="false" />
        <!-- Tracking that was on starts again after a phone restart / app update. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required so the app can capture the device's coordinates at login
         (see AuthScreen.tsx / @capacitor/geolocation). FINE gives GPS-level
         accuracy; COARSE is kept as a fallback the OS may grant instead. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Employee Tracking (Admin Panel -> Employee Tracking): lets the
         background service (@capacitor-community/background-geolocation)
         keep reporting location every ~5-10 min while the app is minimized
         or fully backgrounded, not just while it's open. Only actually used
         for an account with can_use_tracking granted (Admin Panel -> Users) —
         see src/lib/backgroundTracking.ts. Android 10+ requires this as a
         SEPARATE runtime grant from FINE/COARSE above (the user must pick
         "Allow all the time" in the system permission dialog, not just
         "While using the app"). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Lets the background service keep running (and posting its "still
         tracking" notification) after the app is swiped away. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- The ongoing-call service (CallService.java), Android 14+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Employee Tracking starts again after the phone restarts (BootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Asks to let CredenceHR off battery optimisation, so the phone does
         not stop tracking in the background. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Android 13+ requires this to show that foreground-service
         notification at all. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Chat -> voice messages (ChatPanel.tsx's mic button, MediaRecorder
         over getUserMedia({audio:true})). Capacitor's default
         BridgeWebChromeClient handles the WebView's own onPermissionRequest
         for RESOURCE_AUDIO_CAPTURE automatically once this manifest
         permission is granted at runtime, no custom native code needed. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Chat audio/video calls (CallLayer.tsx): camera for video calls, and
         audio routing during a call. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Screen off while a call is held to the ear (CallAudioPlugin.java). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Incoming chat call over the lock screen (IncomingCall.java). On
         Android 14+ the user may have to allow it in the app's settings;
         without it the call still rings as a heads-up notification. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
