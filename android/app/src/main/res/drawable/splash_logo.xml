<?xml version="1.0" encoding="utf-8"?>
<!-- The app opens on its own logo: the same tile, at the same size and in the
     same place (centre of the screen) as the web page's first frame
     (index.html #mpr-boot-spinner .boot-icon, clamp(95px, 31vw, 140px)) and the
     start of the open animation (BootIntroAnimation.tsx).
     Android 12+ and the AndroidX splash on older phones show this drawable on
     the orange (windowSplashScreenBackground). The first item is an empty
     288dp canvas on purpose: the splash draws the icon area at 288dp, and a
     drawable smaller than that would be stretched up to fill it.
     Size: @dimen/splash_logo_size — one step per 20dp of screen width
     (values-swNNNdp), and on Android 12+ (values*-v31) 1/1.5 of it, because
     the system enlarges a splash icon 1.5x as an adaptive icon's foreground
     (124dp set showed at ~186dp on a phone, 23 Nov). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="@dimen/splash_logo_size"
        android:height="@dimen/splash_logo_size"
        android:gravity="center">
        <bitmap
            android:src="@drawable/splash_logo_tile"
            android:gravity="fill" />
    </item>
</layer-list>
