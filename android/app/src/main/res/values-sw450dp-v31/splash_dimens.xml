<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (v31): the system draws the splash icon as an adaptive
     icon's foreground, which it enlarges 1.5x (the 108dp layer shown in a 72dp
     viewport). So the logo is set to 1/1.5 here and lands on screen at 140dp,
     the same size as the web page's first frame (index.html, 31.1% of the
     width, 95-140px). Seen on a phone: 124dp set showed at ~186dp. -->
<resources>
    <dimen name="splash_logo_size">93.33dp</dimen>
</resources>
